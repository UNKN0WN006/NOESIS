# Backend Configuration

# Environment
ENV=development

# Server
HOST=0.0.0.0
PORT=8000

# GitHub API (optional - for higher rate limits)
GITHUB_TOKEN=

# Backend API URL (used by frontend)
BACKEND_URL=http://localhost:8000

# IBM Bob Configuration (when available)
# BOB_MODE: local | cli | http
BOB_MODE=local
# Example: bob chat --json
BOB_CLI_COMMAND=bob
BOB_API_KEY=
BOB_API_ENDPOINT=
